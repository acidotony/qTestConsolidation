# qTest connection settings - TEMPLATE.
#
# Copy this file to config/qtest.env and fill in the real values:
#   cp config/qtest.example.env config/qtest.env
#
# config/qtest.env is git-ignored: it holds credentials and must never be
# committed. Keep this template in sync whenever a new variable is added.
#
# Naming convention: SOURCE_* always refers to the HS instance (migration
# origin) and TARGET_* always refers to the HCSC instance (migration
# destination). Data flows SOURCE (HS) -> TARGET (HCSC), never the other way.

# ---------------------------------------------------------------------------
# SOURCE = HS instance - artifacts are read (exported) from here
# ---------------------------------------------------------------------------
SOURCE_QTEST_BASE_URL=https://source-site.qtestnet.com
SOURCE_QTEST_API_TOKEN=replace-with-source-bearer-token
SOURCE_QTEST_PROJECT_ID=1

# ---------------------------------------------------------------------------
# TARGET = HCSC instance - artifacts are written (imported) here
# ---------------------------------------------------------------------------
TARGET_QTEST_BASE_URL=https://target-site.qtestnet.com
TARGET_QTEST_API_TOKEN=replace-with-target-bearer-token
TARGET_QTEST_PROJECT_ID=1

# ---------------------------------------------------------------------------
# Screenshots of each instance, per side.
#
# The page of an artifact differs between qTest versions and modules, so its
# address is configured rather than built in. Use {base_url}, {project_id} and
# {artifact_id}; WEB_URL_TEMPLATE covers any kind without one of its own, and
# may use {artifact_type} too. Read the address off the browser while looking
# at one artifact of that kind.
#
# Signing in: each instance shows its own login page, one network user and one
# password, no redirect elsewhere and no second factor. Fill in the four
# settings below per side and nothing more is needed.
#
# Captures are PNG, which is what the browser produces. A capture is evidence,
# not the migration: when it cannot be taken the migration carries on and says
# so. WEB_REQUIRED=true makes it fatal instead.
# ---------------------------------------------------------------------------

# -- what to fill in, per side ----------------------------------------------
SOURCE_QTEST_WEB_LOGIN_URL=
SOURCE_QTEST_WEB_USERNAME=
SOURCE_QTEST_WEB_PASSWORD=
SOURCE_QTEST_WEB_URL_REQUIREMENT=

TARGET_QTEST_WEB_LOGIN_URL=
TARGET_QTEST_WEB_USERNAME=
TARGET_QTEST_WEB_PASSWORD=
TARGET_QTEST_WEB_URL_REQUIREMENT=

# WEB_URL_REQUIREMENT is the page of one requirement, with {artifact_id} where
# its id goes; {base_url} and {project_id} are filled in too. Read it off the
# browser while looking at any requirement. One per kind of artifact:
#   ..._WEB_URL_TEST_CASE, ..._WEB_URL_TEST_RUN, ..._WEB_URL_TEST_CYCLE,
#   ..._WEB_URL_TEST_SUITE, ..._WEB_URL_RELEASE, ..._WEB_URL_MODULE
# and WEB_URL_TEMPLATE, which covers any kind without one of its own and may
# use {artifact_type} as well. For example:
# SOURCE_QTEST_WEB_URL_REQUIREMENT={base_url}/p/{project_id}/portal/project#tab=requirements&object=1&id={artifact_id}

# -- only if the defaults do not fit ----------------------------------------
# BROWSER_HEADLESS=false shows the browser while it works, which is how to see
# why a login or a capture went wrong. BROWSER_PROFILE reuses a Chrome profile
# already signed in, and then no user or password is needed at all.
# ---------------------------------------------------------------------------
# SOURCE_QTEST_BROWSER_HEADLESS=true
# SOURCE_QTEST_BROWSER_PROFILE=C:\path\to\a\chrome\profile
# SOURCE_QTEST_BROWSER_WINDOW_SIZE=1920,1080
# SOURCE_QTEST_WEB_PAGE_WAIT=5
# SOURCE_QTEST_WEB_LOGIN_WAIT=15
# SOURCE_QTEST_WEB_USER_SELECTOR=
# SOURCE_QTEST_WEB_PASSWORD_SELECTOR=
# SOURCE_QTEST_WEB_REQUIRED=false

# ---------------------------------------------------------------------------
# Optional, per instance: path to a PEM CA bundle.
#
# Only needed on networks whose proxy re-signs TLS traffic AND whose internal
# CA is not in the operating system trust store. When it is in that store --
# the usual case on a corporate machine -- leave these empty: the client
# verifies against the OS store automatically.
# ---------------------------------------------------------------------------
# SOURCE_QTEST_CA_BUNDLE=C:\path\to\corporate-ca.pem
# TARGET_QTEST_CA_BUNDLE=C:\path\to\corporate-ca.pem

# ---------------------------------------------------------------------------
# Optional: endpoints and export helpers for authentication and authorization.
# The library assumes the standard qTest Manager REST paths for these:
#   /api/v3/users
#   /api/v3/roles
#   /api/v3/permissions
# No extra configuration is required to run the `AuthExporter`, only the
# instance `BASE_URL` and `API_TOKEN` that are already present above.
# ---------------------------------------------------------------------------
